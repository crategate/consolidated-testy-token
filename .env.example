# ════════════════════════════════════════════════════════════════════════════
# AFHO announcement bot (scripts/twitter-announcer.ts)
# Copy this to .env and fill in the values. `.env` is gitignored — never
# commit api keys, api_hash, or the Telegram session string.
# ════════════════════════════════════════════════════════════════════════════

# ── channel switches ("false" disables a channel) ────────────────────────────
X_ENABLED=true
TG_ENABLED=false

# ── X (Twitter) — developer portal → "Keys and tokens" ───────────────────────
# Posting as your own account needs the OAuth 1.0a *user context* pair
# (X_ACCESS_TOKEN + X_ACCESS_TOKEN_SECRET) plus the app consumer key/secret.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Telegram (MTProto userbot via gramjs) ────────────────────────────────────
# TG_API_ID is the INTEGER api id from https://my.telegram.org → "API
# development tools" — it is NOT the api_hash (both live on the same page).
TG_API_ID=
TG_API_HASH=
# Phone number is only needed for the very first login; afterwards the script
# saves TG_SESSION into .env automatically and future runs skip login.
TG_PHONE=
TG_SESSION=
# Channel/group to post into: @username or -100… numeric id. The logged-in
# account must be an admin of that channel with post rights.
TG_CHANNEL=
# "true" = use the Telegram test DCs (149.154.167.40:443) instead of
# production (149.154.167.50:443). Requires an account on the test server.
TG_TEST_SERVER=false

# ── shared ───────────────────────────────────────────────────────────────────
# "true" prepends "devnet testing: " to every announcement.
DEVNET_MODE=false
# "true" logs the post text instead of hitting X / Telegram.
DRY_RUN=false
# Poll cadence in milliseconds (default 60000).
POLL_INTERVAL_MS=60000
# RPC endpoint (defaults to devnet).
RPC_URL=
